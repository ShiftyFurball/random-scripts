{
  "manifest_version": 3,
  "name": "ChatGPT Library Bulk Select",
  "version": "1.0.0",
  "description": "Select or clear loaded image checkboxes in your ChatGPT library.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-library-bulk-select@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
